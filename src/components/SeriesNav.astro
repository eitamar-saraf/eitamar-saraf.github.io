---
// Navigation for the linear-attention series.
//
// Every post in the series renders this at the top, so a reader landing in the middle
// can find the beginning and the sequel. It also matters for the original combined
// post: anyone who bookmarked /blog/kimi-linear bookmarked all of this material at
// once, and this box is how they find where the rest of it went.
//
// Usage:  <SeriesNav current="kda" />
const { current } = Astro.props;

const POSTS = [
  { slug: 'linear-attention', n: 1, title: 'Attention without a KV cache' },
  { slug: 'delta-rule',       n: 2, title: 'The delta rule' },
  { slug: 'gated-deltanet',   n: 3, title: 'Teaching it to forget' },
  { slug: 'kda',              n: 4, title: 'Kimi Delta Attention' },
  { slug: 'mla',              n: 5, title: 'Multi-head Latent Attention', pending: true },
  { slug: 'kimi-linear',      n: 6, title: 'Kimi Linear: the hybrid' },
];

const here = POSTS.find((p) => p.slug === current);
---

<nav class="not-prose mb-6 rounded-lg border border-gray-200 bg-white p-4 text-sm">
  <div class="mb-2 flex items-baseline gap-2">
    <span class="font-semibold text-gray-900">Linear attention, one piece at a time</span>
    {here && <span class="text-gray-500">— part {here.n} of {POSTS.length}</span>}
  </div>
  <ol class="space-y-1">
    {POSTS.map((p) => (
      <li class="flex gap-2">
        <span class={p.slug === current ? 'font-semibold text-gray-900' : 'text-gray-400'}>{p.n}.</span>
        {p.slug === current ? (
          <span class="font-semibold text-gray-900">{p.title} <span class="font-normal text-gray-500">— you are here</span></span>
        ) : p.pending ? (
          <span class="text-gray-400">{p.title} <span class="text-xs">(not written yet)</span></span>
        ) : (
          <a href={`/blog/${p.slug}`} class="text-blue-700 hover:underline">{p.title}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
