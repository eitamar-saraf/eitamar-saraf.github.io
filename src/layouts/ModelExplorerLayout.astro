---
// Two columns: the model's flow chart on the left (sticky on wide screens), the
// block-by-block walkthrough on the right. A click on the chart jumps to the block;
// scrolling the walkthrough highlights where you are on the chart.
import BaseLayout from './BaseLayout.astro';
import FlowChart from '../components/explorer/FlowChart.astro';
import type { FlowNode } from '../data/models/flow';

interface Props {
  title: string;
  description: string;
  flow: FlowNode;
}

const { title, description, flow } = Astro.props;
---

<BaseLayout pageTitle={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 pb-24 lg:grid lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-10">
    <aside class="mb-8 lg:mb-0">
      <div class="flow-chart rounded-lg border border-gray-200 bg-white p-3 lg:sticky lg:top-[132px] lg:max-h-[calc(100vh-150px)] lg:overflow-y-auto">
        <a href={`#${flow.id}`} class="flow-node flow-root" data-flow-target={flow.id}>
          <span class="font-semibold">{flow.label}</span>
        </a>
        <span class="flow-arrow" aria-hidden="true">↓</span>
        <FlowChart nodes={flow.children ?? []} />
        <p class="mt-3 text-[11px] text-gray-500">Click any block to jump to it.</p>
      </div>
    </aside>

    <main class="min-w-0 max-w-3xl">
      <slot />
    </main>
  </div>
</BaseLayout>

<style is:global>
  .flow-node {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    background: #fff;
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
    color: #111827;
    transition: background-color 120ms, border-color 120ms;
  }
  .flow-node:hover { border-color: #2a78d6; background: #eff6ff; }
  .flow-node.is-active { border-color: #2a78d6; background: #2a78d6; color: #fff; }
  .flow-node.is-active .flow-shape,
  .flow-node.is-active .flow-repeat { color: #dbeafe; }
  .flow-root { background: #111827; border-color: #111827; color: #fff; }
  .flow-group {
    border: 1px dashed #cbd5e1;
    border-radius: 0.5rem;
    padding: 0.25rem;
    background: #f8fafc;
  }
  .flow-group.is-ancestor { border-color: #2a78d6; background: #f0f7ff; }
  .flow-group-header { border-style: solid; background: #f1f5f9; }
  .flow-shape { font-family: ui-monospace, monospace; font-size: 0.6875rem; color: #6b7280; white-space: nowrap; }
  .flow-repeat { font-family: ui-monospace, monospace; font-size: 0.75rem; color: #2a78d6; font-weight: 600; }
  .flow-arrow { display: block; text-align: center; font-size: 0.75rem; line-height: 1rem; color: #9ca3af; }
  .block-section { scroll-margin-top: 136px; padding-top: 2.5rem; }
  .block-section + .block-section { border-top: 1px solid #e5e7eb; margin-top: 2.5rem; }
  .block-prose code { font-family: ui-monospace, monospace; font-size: 0.875em; background: #f3f4f6; padding: 0 0.25rem; border-radius: 0.25rem; }
  .block-section pre.astro-code { padding: 0.75rem 1rem; margin: 0; overflow-x: auto; }
  html { scroll-behavior: smooth; }
</style>

<script>
  // Highlight the chart box for the section currently being read, plus the dashed
  // containers (transformer block, attention, MLP) that it sits inside.
  const READING_LINE_PX = 160;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-block-section]'));
  const chartNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-flow-target]'));

  function currentSectionId(): string | null {
    let current: string | null = sections[0]?.id ?? null;
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= READING_LINE_PX) current = section.id;
    }
    return current;
  }

  function highlight(sectionId: string | null): void {
    for (const node of chartNodes) {
      node.classList.toggle('is-active', node.dataset.flowTarget === sectionId);
    }
    for (const group of document.querySelectorAll<HTMLElement>('[data-flow-group]')) {
      const containsActive = group.querySelector(`[data-flow-target="${sectionId}"]`) !== null;
      group.classList.toggle('is-ancestor', containsActive);
    }
  }

  let scheduled = false;
  function onScroll(): void {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => {
      scheduled = false;
      highlight(currentSectionId());
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  highlight(currentSectionId());
</script>
