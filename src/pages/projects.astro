---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="max-w-5xl mx-auto py-16 px-4">
    <h1 class="text-3xl font-bold mb-4">Projects</h1>
    <p class="mb-6 text-gray-700">Explore my interactive ML projects and demos.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border rounded-lg p-4 shadow-sm bg-white">
        <h2 class="text-xl font-semibold mb-2">Kimi Delta Attention</h2>
        <p class="mb-3 text-gray-700">Kimi Delta Attention implemented and illustrated: one recurrence, tested against the paper, with interactive figures that run the same maths in the browser.</p>
        <ul class="list-disc list-inside space-y-1 text-blue-700">
          <li><a href="https://github.com/eitamar-saraf/kda" target="_blank" rel="noopener" class="hover:underline">Repository</a></li>
          <li><a href="/blog/linear-attention" class="hover:underline">Writeup (series, part 1)</a></li>
        </ul>
      </div>
    </div>
  </main>
</BaseLayout>
